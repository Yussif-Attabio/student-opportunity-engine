# =============================================================================
# STUDENT OPPORTUNITY ENGINE - GROQ AI SETUP
# =============================================================================
# Copy to .env.local and fill values:
#   cp .env.example .env.local
#
# Start local dev:
#   npm run dev
#
# Frontend: http://localhost:5173
# Local API: http://localhost:3001
# =============================================================================

# Frontend-safe flag
VITE_AI_ENABLED=true

# Local API server port
API_PORT=3001

# PostgreSQL / Supabase
DATABASE_URL=postgresql://postgres:password@host:6543/postgres
DATABASE_DIRECT_URL=postgresql://postgres:password@host:5432/postgres
DATABASE_TEST_URL=postgresql://postgres:postgres@localhost:5432/student_opportunity_test
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Ingestion scheduling and durable queues
APP_URL=https://your-app.vercel.app
CRON_SECRET=replace_with_a_long_random_secret
QSTASH_TOKEN=your_qstash_token
QSTASH_CURRENT_SIGNING_KEY=your_current_qstash_signing_key
QSTASH_NEXT_SIGNING_KEY=your_next_qstash_signing_key

# Ingestion controls
MISSED_SYNC_THRESHOLD=3
SOURCE_FETCH_TIMEOUT_MS=10000
SOURCE_MAX_RESPONSE_BYTES=10485760
SYNC_PROVIDER_CONCURRENCY=3
CLASSIFICATION_CONCURRENCY=1
CLASSIFICATION_RATE_PER_MINUTE=2
CLASSIFIER_VERSION=student-opportunity-v1
LOG_LEVEL=info
REMOVAL_CONTACT_EMAIL=opportunities@example.com

# Server-side only (do NOT expose in VITE_ vars)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: adds free federal student jobs to the public employer feeds.
# Request a key at https://developer.usajobs.gov/
USAJOBS_API_KEY=your_usajobs_api_key_here
USAJOBS_USER_AGENT=your_email@example.com

# =============================================================================
# NOTES
# =============================================================================
# 200 on POST /api/generate-guidance = Groq call succeeded (AI guidance shown)
# 500 on POST /api/generate-guidance = backend/Groq failed (local fallback shown)
# GET /api/jobs works without credentials using selected Greenhouse and Lever feeds.
# USAJOBS listings are included only when both USAJOBS values above are configured.
# Keep .env.local out of git (contains secrets)
# =============================================================================
