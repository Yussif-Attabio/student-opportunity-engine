# =============================================================================
# STUDENT OPPORTUNITY ENGINE - GROQ AI SETUP
# =============================================================================
# Copy to .env.local and fill values:
#   cp .env.example .env.local
#
# Start local dev:
#   npm run dev
#
# Frontend: http://localhost:5173
# Local API: http://localhost:3001
# =============================================================================

# Frontend-safe flag
VITE_AI_ENABLED=true

# Local API server port
API_PORT=3001

# Server-side only (do NOT expose in VITE_ vars)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# =============================================================================
# NOTES
# =============================================================================
# 200 on POST /api/generate-guidance = Groq call succeeded (AI guidance shown)
# 500 on POST /api/generate-guidance = backend/Groq failed (local fallback shown)
# Keep .env.local out of git (contains secrets)
# =============================================================================
